# Copy these into your hosting settings (for example Vercel, Settings, Environment Variables).
# Never commit real values. See docs/SETUP.md for where each one comes from.

# GitHub OAuth app (the "Sign in with GitHub" button)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# A fine-grained token with Contents: Read and write on your repository.
# Saves are made with this, so people you add never need access to the repository.
GITHUB_TOKEN=

# The GitHub username of the site owner (the only person who can manage the team).
ALLOWED_USER=

# The contact form, sent through Resend (https://resend.com). See docs/CONTACT-SETUP.md.
RESEND_API_KEY=
CONTACT_TO=
# CONTACT_FROM=My Site <hello@yourdomain.com>   (optional, needs a domain verified in Resend)

# Only needed if you are NOT deploying from GitHub to Vercel (Vercel fills these in for you).
# GITHUB_OWNER=
# GITHUB_REPO=
# GITHUB_BRANCH=main
